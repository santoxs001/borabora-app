# ── HEY · environment ─────────────────────────────────────────────
# The prototype runs fully on the in-memory/localStorage mock adapter,
# so none of these are required for `npm run dev`.

# Data adapter: "mock" | "supabase"
NEXT_PUBLIC_DATA_ADAPTER=mock

# Supabase (when NEXT_PUBLIC_DATA_ADAPTER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Media storage bucket for profile photos
NEXT_PUBLIC_SUPABASE_PHOTO_BUCKET=profile-photos

# Maps (aggregate HEY Places only — never individual user coordinates)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Age gate
NEXT_PUBLIC_MIN_AGE=18
