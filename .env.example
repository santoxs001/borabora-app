# ===========================================================================
# Buffet Bora Bora - configuração do sistema de câmeras
#
# 1. Copie este arquivo para ".env"      ->  cp .env.example .env
# 2. Preencha as senhas
# 3. NUNCA suba o .env para o GitHub (já está no .gitignore)
#
# ATENÇÃO: valores com "$" (os hashes bcrypt) PRECISAM ficar entre aspas
# simples, senão o Docker tenta interpretar o $ como variável.
# ===========================================================================

# --------------------------------------------------------------- geral
TZ=America/Sao_Paulo

# Qual arquivo de câmeras usar.
#   cameras.teste.yaml -> modo de teste, com câmeras falsas (padrão)
#   cameras.yaml       -> instalação de verdade
CAMERAS_FILE=cameras.teste.yaml

# Em qual endereço os serviços ficam ouvindo.
#   0.0.0.0 = toda a rede local (padrão, mais simples)
#   192.168.0.10 = só nessa placa de rede (mais fechado; use o IP do servidor)
BIND_IP=0.0.0.0

# Onde ficam as gravações. Troque pelo HD separado, por exemplo:
#   Linux:   /mnt/hd-cameras
#   Windows: C:/cameras   (ou D:/cameras)
PASTA_GRAVACOES=./gravacoes

# --------------------------------------------------------------- câmeras
# Senha das câmeras (a mesma que você configurou no app Yoosee).
CAM_SENHA_PADRAO=troque-esta-senha

# --------------------------------------------------------------- painel
PAINEL_PORTA=8080

# Chave que assina o cookie de login. Gere uma sua com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PAINEL_SEGREDO=troque-por-uma-chave-aleatoria-bem-grande

# Usuários do painel. Gere os hashes com:
#   python3 scripts/gerar_hash.py
# (ou, sem Python instalado: docker compose run --rm gerador python scripts/gerar_hash.py)
#
# Os hashes de exemplo abaixo são das senhas "admin123" e "equipe123":
# TROQUE OS DOIS ANTES DE USAR DE VERDADE.
PAINEL_ADMIN_USUARIO=admin
PAINEL_ADMIN_HASH='$2b$12$gjfTniC/iRfVxy4jPOm.DeaJ0cCSTWSgtfte5qD71M241JhgrZj6q'

PAINEL_VISUALIZADOR_USUARIO=equipe
PAINEL_VISUALIZADOR_HASH='$2b$12$QTbd6tcv92BTAg6cLVGcaeREKOD052tpRX1ou.uIkfV7IkpqnY1RG'

# Quantas horas o login continua valendo sem precisar digitar a senha de novo.
PAINEL_HORAS_SESSAO=12

# --------------------------------------------------------------- vídeo ao vivo
# IP do servidor na rede local. Sem isso o vídeo ao vivo (WebRTC) não conecta
# no celular. Ex.: 192.168.0.10
GO2RTC_CANDIDATE=

# Endereço do go2rtc como o NAVEGADOR enxerga. Deixe vazio para o painel usar
# o mesmo IP da página na porta 1984 (funciona na maioria dos casos).
PAINEL_GO2RTC_PUBLICO=

# --------------------------------------------------------------- watchdog
WATCHDOG_INTERVALO=60           # segundos entre as checagens
WATCHDOG_REINICIAR_APOS=180     # segundos sem vídeo antes de reiniciar a câmera
WATCHDOG_ESPERA_REBOOT=600      # espera mínima entre dois reinícios da mesma câmera
WATCHDOG_MAX_REBOOTS_HORA=3

# --------------------------------------------------------------- versões
GO2RTC_VERSION=latest
FRIGATE_VERSION=0.15.2
MEDIAMTX_VERSION=latest-ffmpeg
